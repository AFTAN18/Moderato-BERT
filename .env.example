# Moderato-BERT environment variables
#
# Copy this file to .env for local development. In Vercel, add the same
# variables under Project Settings -> Environment Variables.

# AI inference. Claude is used first when present; Gemini is the fallback.
CLAUDE_API_KEY=""
GEMINI_API_KEY=""

# Supabase server-side access. Keep the service role key server-only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Browser-safe Supabase values used by the Vite frontend.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional external Python ML service for non-Vercel deployments.
# Vercel does not run the Dockerized ml-service from this repo.
ML_SERVICE_URL=""
